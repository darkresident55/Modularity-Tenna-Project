            }
            SETTING = (key="animationRefs") {
                value=Object.ID-70;Object.ID-38;
            }
            SETTING = (key="lines") {
                value=WELCOME back, everyone, to the show that'll make you SCREAM at your SCREEN,||0.035000	[FT_TvTime]________________________!!||0.035000	Would everyone please give a warm welcome...||0.035000	To today's contestants!!!||0.035000	Everyone got their snacks and drinks?||0.035000	Once the show starts there will be NO bathroom breaks!||0.035000	Are we all ready to begin the show?!||0.035000	Your [FT_Names]_________________  Please!||0.035000	Now that we've been (Im)properly introduced...||0.035000	[BG:TennaRealTV] Haha! Wish I could go but I'm just a big electric box attached to the wall!! Haha!!||0.035000	[BG:TennaRealTVSepia] (Though I would look good with a tan.)||0.035000	Are you ready! because...||0.035000	[TV_TIME]||0.035000	But hey, that's show business! Nothing... stays big forever.||0.035000	Isn't it about time you got a new TV?||0.035000	Great! Mike, hit it!||0.035000	||0.035000;
            }
            SETTING = (key="dialogueBlock") {
